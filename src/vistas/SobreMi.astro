---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Foto from '../components/Foto.astro';
import Enc from '../components/Enc.astro';
import { t, tr } from '../data/textos.js';
import { ruta } from '../utils.js';
import { sobreMi as S, persona, google } from '../data/sitio.js';
const { lang = 'es' } = Astro.props;
const w = (es, en) => tr({ es, en }, lang);
const x = t(lang), en = lang === 'en';
const titulo = w('Sobre mí | Jose Adrianzen, director de cine peruano', 'About | Jose Adrianzen, Peruvian film director');
const desc = tr({ es: 'Jose Adrianzen, director y productor de cine peruano. Estudió cine en EPIC y dirigió el documental premiado Entre polvo y sueños y el corto ECO.', en: 'Jose Adrianzen, Peruvian film director and producer. He trained at EPIC and directed the award winning documentary Between Dust and Dreams and the short ECO.' }, lang);
const ldPerfil = { '@context': 'https://schema.org', '@type': 'ProfilePage', mainEntity: { '@id': 'https://joseadrianzen.com/#jose' }, inLanguage: lang };
---
<Base titulo={titulo} descripcion={desc} lang={lang} camino="sobre-mi" actual="sobre-mi" tipo="profile" jsonLd={ldPerfil} navClara>
  <section class="yo papel grano">
    <Foto n={S.retrato} clase="yo-foto" alt="Jose Adrianzen" eager pix sizes="(max-width: 860px) 100vw, 48vw" pos="50% 35%" />
    <div class="yo-texto">
      <p class="rol" data-aparece>{tr(persona.rol, lang)}</p>
      <h1 class="yo-logo"><span class="mascara"><Logo variante="sobre-mi" armar titulo="Jose Adrianzen" lang={lang} /></span></h1>
      <div class="bio">{tr(S.bio, lang).map((p) => <p data-lineas>{p}</p>)}</div>
    </div>
  </section>

  <section class="cita oscuro grano">
    <p data-lineas>“{tr(S.cita, lang)}”</p>
    <p class="cod" data-aparece>Jose Adrianzen · {w('sobre Entre polvo y sueños', 'on Between Dust and Dreams')}</p>
  </section>

  <section class="trayecto papel grano">
    <Enc t={x.trayectoria} d={w('la tira de mi vida en cine', 'my life in film, frame by frame')} />
    <div class="tira-vida" data-cascada>{S.trayecto.map((e, k) => <div><b>{String(k + 1).padStart(2, '0')}</b><span>{tr(e, lang)}</span></div>)}</div>
  </section>

  <section class="muro oscuro grano">
    <Enc t={w('En cámara y fuera de ella', 'On and off camera')} d="" osc />
    <div class="escalera">{S.muro.map(([n, a], k) => <Foto n={n} clase={`e e${k % 3}`} alt={tr(a, lang)} cursor={x.cursor.ver} sizes="(max-width: 860px) 50vw, 25vw" />)}</div>
  </section>

  <section class="dos-bloques papel grano">
    <div>
      <Enc t={x.formacion} d="" />
      <ul class="datos" data-cascada>{S.formacion.map((f) => <li>{tr(f, lang)}</li>)}</ul>
    </div>
    <div>
      <Enc t={x.prensa} d="" />
      {google.dossier
        ? <a class="descarga" href={google.dossier} target="_blank" rel="noopener">{x.dossier} <span>↗</span></a>
        : <p class="descarga" aria-disabled="true">{x.dossier} <span>{x.proximamente}</span></p>}
      {google.fotosAlta
        ? <a class="descarga" href={google.fotosAlta} target="_blank" rel="noopener">{x.fotosAlta} <span>↗</span></a>
        : <p class="descarga" aria-disabled="true">{x.fotosAlta} <span>{x.proximamente}</span></p>}
      <a class="lnk" href={ruta('contacto', lang)} data-aparece>{x.escribeme}</a>
    </div>
  </section>
</Base>
