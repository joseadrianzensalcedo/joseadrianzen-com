---
import Base from '../layouts/Base.astro';
import { t, tr } from '../data/textos.js';
import { vias, persona, google } from '../data/sitio.js';
const { lang = 'es' } = Astro.props;
const w = (es, en) => tr({ es, en }, lang);
const x = t(lang), en = lang === 'en';
const correo = vias[0];
const titulo = w('Contacto | Jose Adrianzen', 'Contact | Jose Adrianzen');
const desc = w('Escríbele a Jose Adrianzen sobre proyectos, festivales y prensa.', 'Write to Jose Adrianzen about projects, festivals and press.');
---
<Base titulo={titulo} descripcion={desc} lang={lang} camino="contacto" actual="contacto" clase="noche">
  <section class="escribe oscuro grano">
    <p class="cod" data-aparece><span>{x.escribeme}</span><span>{x.publicoContacto}</span></p>
    <h1 class="visually-hidden">{x.contacto}</h1>
    <a class="correo" href={correo.href} data-letras="titulo">{persona.correo}</a>
    <div class="canales" data-cascada>
      {vias.slice(1).map((v) => <a class="canal" href={v.href} target="_blank" rel="noopener"><b>{tr(v.t, lang)}</b><span>{v.v}</span><em aria-hidden="true">↗</em></a>)}
    </div>
    <form class="mensaje" id="escribeme" action="/escribe/" method="post" novalidate data-lang={lang} data-txt={JSON.stringify({ falta: w('Revisa los campos marcados.', 'Check the marked fields.'), manda: w('Enviando…', 'Sending…'), ok: w('Mensaje enviado. Te respondo pronto.', 'Message sent. I will reply soon.'), mal: w('No se pudo enviar. Escríbeme a yo@joseadrianzen.com.', 'It did not go through. Write to me at yo@joseadrianzen.com.') })}>
      <h2 class="mensaje-t">{w('Déjame un mensaje', 'Leave me a message')}</h2>
      <p class="cod">{w('Te respondo al correo o al teléfono que dejes.', 'I will reply to the email or phone you leave.')}</p>
      <div class="mensaje-filas">
        <label class="campo ancho"><span>{w('Nombre', 'Name')}</span><input name="nombre" autocomplete="name" required minlength="2" maxlength="120"></label>
        <label class="campo"><span>{w('Correo', 'Email')}</span><input name="correo" type="email" autocomplete="email" inputmode="email" required maxlength="200"></label>
        <label class="campo"><span>{w('Teléfono o WhatsApp', 'Phone or WhatsApp')}</span><input name="telefono" type="tel" autocomplete="tel" inputmode="tel" required minlength="6" maxlength="25" pattern="[+0-9 ().\-]{6,25}" placeholder="+51"></label>
        <label class="campo ancho"><span>{w('Mensaje', 'Message')}</span><textarea name="mensaje" rows="5" required minlength="10" maxlength="4000"></textarea></label>
      </div>
      <label class="trampa" aria-hidden="true">Web<input name="web" tabindex="-1" autocomplete="off"></label>
      <input type="hidden" name="idioma" value={lang}>
      <label class="acepto"><input type="checkbox" name="acepto" value="1" required><span>{w('Acepto que se usen estos datos solo para responderme.', 'I agree these details are used only to reply to me.')} <a href={lang === 'es' ? '/privacidad/' : `/${lang}/privacidad/`}>{w('Privacidad', 'Privacy')}</a></span></label>
      <button type="submit" class="mensaje-enviar">{w('Enviar', 'Send')} <span aria-hidden="true">→</span></button>
      <p class="mensaje-estado" role="status" aria-live="polite"></p>
    </form>
    {google.citas && (
      <div class="citas">
        <button type="button" class="citas-abrir" aria-expanded="false" aria-controls="citas-marco">{w('Agenda una llamada conmigo', 'Book a call with me')} <span aria-hidden="true">→</span></button>
        <p class="cod">{w('Elige un horario libre. Te llega la invitación con el enlace de Meet.', 'Pick a free slot. You get the invite with the Meet link.')}</p>
        <div class="citas-marco" id="citas-marco" hidden data-src={google.citas}></div>
        <a class="citas-fuera" href={google.citas.replace('?gv=true', '')} target="_blank" rel="noopener">{w('Abrir la agenda en otra pestaña', 'Open the booking page in a new tab')} ↗</a>
      </div>
    )}
    {google.disponibilidad && (
      <div class="dispo">
        <p class="cod">{w('Mi disponibilidad esta semana', 'My availability this week')}</p>
        <p class="dispo-nota">{w('Los bloques son horas ocupadas. El resto está libre. La hora se muestra en la tuya.', 'Blocks are busy hours. The rest is free. Times are shown in your time zone.')}</p>
        <div class="dispo-marco" data-cal={google.disponibilidad} data-lang={lang === 'es' ? 'es' : lang}></div>
      </div>
    )}
    <p class="cod base" data-aparece>{tr(persona.base, lang)}</p>
  </section>
  <script>
    // El calendario se pide recién cuando está cerca de la pantalla, en la zona horaria de quien mira.
    document.querySelectorAll('.dispo-marco').forEach((m) => {
      const poner = () => {
        if (m.firstChild) return;
        let zona = 'America/Lima'; try { zona = Intl.DateTimeFormat().resolvedOptions().timeZone || zona; } catch (e) {}
        const p = new URLSearchParams({ src: m.dataset.cal, ctz: zona, mode: 'WEEK', showTitle: '0', showPrint: '0', showTabs: '0', showCalendars: '0', showTz: '1', wkst: '2', hl: m.dataset.lang });
        const f = document.createElement('iframe'); f.src = 'https://calendar.google.com/calendar/embed?' + p; f.title = 'Disponibilidad'; f.loading = 'lazy'; f.referrerPolicy = 'no-referrer';
        m.appendChild(f);
      };
      if ('IntersectionObserver' in window) { const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { poner(); io.disconnect(); } }, { rootMargin: '400px' }); io.observe(m); } else poner();
    });
    document.querySelectorAll('.citas-abrir').forEach((b) => b.addEventListener('click', () => {
      const m = document.getElementById('citas-marco');
      if (!m.firstChild) { const f = document.createElement('iframe'); f.src = m.dataset.src; f.title = 'Agenda'; f.loading = 'lazy'; m.appendChild(f); }
      m.hidden = !m.hidden; b.setAttribute('aria-expanded', String(!m.hidden));
    }));

    // Formulario: se manda sin recargar. Sin JavaScript también funciona (el servidor vuelve a esta página).
    const fm = document.getElementById('escribeme');
    if (fm) {
      const t0 = Date.now(), est = fm.querySelector('.mensaje-estado');
      const txt = JSON.parse(fm.dataset.txt);
      if (location.search.includes('enviado=1')) { est.textContent = txt.ok; est.dataset.tipo = 'ok'; }
      fm.addEventListener('input', (e) => e.target.closest('.campo, .acepto')?.classList.remove('mal'));
      fm.addEventListener('submit', async (e) => {
        e.preventDefault();
        let bien = true;
        fm.querySelectorAll('input[required], textarea[required]').forEach((c) => { if (!c.checkValidity()) { c.closest('.campo, .acepto')?.classList.add('mal'); bien = false; } });
        if (!bien) { est.textContent = txt.falta; est.dataset.tipo = 'mal'; fm.querySelector('.mal input, .mal textarea')?.focus(); return; }
        const d = Object.fromEntries(new FormData(fm)); d.t = Date.now() - t0; d.pagina = location.pathname;
        const b = fm.querySelector('button'); b.disabled = true; est.textContent = txt.manda; est.dataset.tipo = '';
        try {
          const r = await fetch('/escribe/', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(d) });
          const j = await r.json().catch(() => ({}));
          if (!r.ok || !j.ok) throw new Error(j.error || r.status);
          fm.reset(); est.textContent = txt.ok; est.dataset.tipo = 'ok';
        } catch (err) { est.textContent = txt.mal; est.dataset.tipo = 'mal'; }
        b.disabled = false;
      });
    }
  </script>
</Base>
