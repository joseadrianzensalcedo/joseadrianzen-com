---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import { t, tr } from '../data/textos.js';
import { ruta, fechaLegible, minutos } from '../utils.js';
const { art, lang = 'es', numero } = Astro.props;
const w = (es, en) => tr({ es, en }, lang);
const x = t(lang);
const url = 'https://joseadrianzen.com' + ruta('blog/' + art.slug, 'es');
const ld = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: art.titulo, description: art.descripcion, datePublished: art.fecha, dateModified: art.fecha, inLanguage: 'es',
  mainEntityOfPage: url, author: { '@id': 'https://joseadrianzen.com/#jose' }, publisher: { '@id': 'https://joseadrianzen.com/#jose' } };
---
<Base titulo={`${art.titulo} | Jose Adrianzen`} descripcion={art.descripcion} lang={lang} camino={'blog/' + art.slug} actual="blog" tipo="article" jsonLd={ld} navClara altOg={art.alt} soloEs>
  <div class="barra-lectura" aria-hidden="true"><i></i></div>
  <article class="post papel grano">
    <header class="post-cab">
      <p class="cod" data-aparece><a href={ruta('blog', lang)}>{x.volverBlog}</a><span>{w('Artículo', 'Article')} {numero}</span><span>{fechaLegible(art.fecha, 'es')}</span><span>{minutos(art)} {x.leer}</span></p>
      {art.estado !== 'publicado' && <p class="sello-borrador">{x.borrador}</p>}
      <h1 class="art-titulo" data-letras="titulo">{art.titulo}</h1>
    </header>
    <Foto n={art.imagen} clase="post-figura" alt={art.alt} eager sizes="(max-width: 860px) 100vw, 760px" />
    <p class="post-pie cod">{art.pie}</p>
    <div class="post-cuerpo">
      {art.cuerpo.map((p) => p.startsWith('## ') ? <h2 class="art-sub" data-lineas>{p.slice(3)}</h2> : <p data-lineas>{p}</p>)}
      <p class="post-firma">{art.firma}</p>
    </div>
  </article>
</Base>
