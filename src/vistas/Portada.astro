---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Foto from '../components/Foto.astro';
import Enc from '../components/Enc.astro';
import Laurel from '../components/Laurel.astro';
import { Image, getImage } from 'astro:assets';
import { t, tr } from '../data/textos.js';
import { ruta, PROTOTIPO } from '../utils.js';
import { idea, documental as D, eco as E, premios, selecciones, persona } from '../data/sitio.js';
import { visibles } from '../data/blog.js';
import { docTexto, docPintado, docDibujado, ecoTitulo } from '../data/titulos.js';
const { lang = 'es' } = Astro.props;
const w = (es, en) => tr({ es, en }, lang);
const x = t(lang);
const fotos = import.meta.glob('/src/assets/img/*.webp', { eager: true });
const img = (n) => fotos[`/src/assets/img/${n}.webp`].default;
const movil = await getImage({ src: (await import('../assets/img/doc-lago-m.webp')).default, widths: [480, 800, 864], format: 'webp', quality: 88 });
const arts = visibles(PROTOTIPO).slice(0, 3);
const HOJA = [['fot-puerto', 'an', w('Grúas del puerto del Callao bajo un cielo naranja', 'Cranes at the port of Callao under an orange sky')], ['jose-shipibo', 'md', w('Jose con amigos shipibo en la calle', 'Jose with Shipibo friends in the street')], ['fot-mar', 'an', w('Mar abierto al amanecer', 'Open sea at dawn')], ['fot-barcelona', 'ch', w('Fachadas con balcones en Barcelona', 'Facades with balconies in Barcelona')], ['fot-gaviota', 'md', w('Proa de un buque y una gaviota en el puerto', 'A ship’s bow and a seagull in the port')]];
const titulo = w('Jose Adrianzen | Director de cine peruano', 'Jose Adrianzen | Peruvian film director');
const desc = w('Jose Adrianzen, director y productor de cine peruano. Documental premiado Entre polvo y sueños y cortometraje ECO.', 'Jose Adrianzen, Peruvian film director and producer. Award winning documentary Dust and Dreams and the short film Echo.');
const ld = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Jose Adrianzen', url: 'https://joseadrianzen.com/', inLanguage: lang };
---
<Base titulo={titulo} descripcion={desc} lang={lang} jsonLd={ld}>
  <!-- Portada ordenada por la diseñadora (1 oct 2026): arriba el nombre como logo, en el centro la película con sus premios,
       abajo a la izquierda el título con sus datos y a la derecha la sinopsis con el botón. Todo con la letra de la web. -->
  <section class="hero hero-peli oscuro">
    <picture>
      <source media="(max-width: 860px)" srcset={movil.srcSet.attribute} sizes="100vw" type="image/webp" />
      <Image class="fondo" src={img('doc-lago')} alt={w('Mineras con casco rojo buscan mineral en la ladera, con una laguna andina al fondo', 'Women miners in red helmets search for ore on the slope, with an Andean lagoon behind')} widths={[800, 1200, 1800, 2048]} sizes="100vw" quality={88} loading="eager" fetchpriority="high" />
    </picture>
    <div class="velo velo-peli"></div>
    <h1 class="visually-hidden">Jose Adrianzen, {tr(persona.rol, lang)}</h1>
    <div class="hero-marco">
      <div class="hero-izq">
        <ul class="laureles" data-cascada>{premios.map((p) => <Laurel laurel={p.laurel} alt={`${tr(p.k, lang)}, ${p.v}, ${tr(p.d, lang)}`} alto={140} carga="eager" />)}</ul>
        <h2 class="gigante claro titulo-pelicula" data-letras="gigante" aria-label={docDibujado(lang) ? docTexto(lang) : undefined}>{docPintado(lang).map((l) => <span aria-hidden={docDibujado(lang) ? 'true' : undefined}>{l}</span>)}</h2>
        <p class="peli-datos" data-aparece><span>{x.documental}</span><span>{D.duracion}</span><span>{D.formato}</span><span>{w('Perú', 'Peru')}, {D.anio}</span></p>
      </div>
      <div class="hero-acc">
        <p class="hero-sinopsis">{tr(D.sinopsis, lang)[0]}</p>
        <a class="btn" href={ruta(D.slug, lang) + '#sala'}>{w('▶ Ver documental', '▶ Watch the documentary')}</a>
      </div>
    </div>
    <button class="pausa" type="button" aria-pressed="false">{x.pausa}</button>
  </section>

  <section class="idea papel grano">
    <Enc t={x.laIdea} />
    <div class="idea-caja">
      <h2 class="gigante" data-letras="gigante"><span>{tr(idea.lineas, lang).split('|')[0]}</span><span class="s2">{tr(idea.lineas, lang).split('|')[1]}</span><span class="s3">{tr(idea.lineas, lang).split('|')[2]}</span></h2>
      <div class="idea-der">
        <Foto n="doc-casco" clase="idea-foto" alt={w('Una minera con casco amarillo mira a cámara', 'A woman miner in a yellow helmet looks into the camera')} paralaje cursor={x.cursor.ver} sizes="(max-width: 860px) 80vw, 40vw" />
        <p class="idea-txt" data-lineas>{tr(idea.texto, lang)}</p>
      </div>
    </div>
  </section>

  <section class="peli oscuro grano" id="peliculas">
    <Enc t={x.peliculas} osc />
    <div class="peli-caja">
      <a href={ruta(D.slug, lang)} class="peli-enlace" aria-label={docTexto(lang)}><Foto n="doc-mineras" clase="peli-foto" movil={false} alt={w(D.fotogramas[1][1], D.fotogramas[1][2])} cursor={x.cursor.ver} sizes="(max-width: 860px) 100vw, 56vw" /></a>
      <div class="peli-txt">
        <h2 class={docDibujado(lang) ? 'titulo titulo-pelicula' : 'titulo'} data-letras="titulo" aria-label={docDibujado(lang) ? docTexto(lang) : undefined}>{docDibujado(lang) ? <span aria-hidden="true">{docPintado(lang).join(' ')}</span> : docTexto(lang)}</h2>
        <p class="cod" data-aparece>{w('Documental · Perú', 'Documentary · Peru')} · {D.anio} · {D.duracion} · {D.formato}</p>
        <p class="golpe" data-lineas>“{tr(D.golpe, lang)}”</p>
        <p class="lect" data-lineas>{tr(D.sinopsis, lang)[0]}</p>
        <a class="lnk" href={ruta(D.slug, lang)} data-aparece>{x.verPelicula}</a>
      </div>
    </div>
    <div class="premios" data-cascada>{premios.slice(0, 3).map((p) => <div><b data-descifra>{p.corto}</b><span>{tr(p.k, lang)}</span></div>)}</div>
    <div class="franja-ctl"><button type="button" aria-pressed="false">{x.detener}</button></div>
    <div class="franja" aria-label={x.selecciones}><p>{[...selecciones, ...selecciones].map((s) => s.n).join(' · ')} · </p></div>
  </section>

  <section class="fotos papel grano" id="fotografia">
    <Enc t={x.fotografia} />
    <div class="carril" data-cursor={x.cursor.arrastra}>
      <div class="hoja">
        {HOJA.map(([n, c, a], i) => <figure class={c}><Image src={img(n)} alt={a} widths={[480, 800]} sizes="40vw" draggable="false" /></figure>)}
      </div>
    </div>
    <a class="lnk osc-l" href={ruta('fotografia', lang)} data-aparece>{x.verTodas}</a>
  </section>

  <section class="eco oscuro grano">
    <Enc t={x.peliculas} osc />
    <div class="eco-caja">
      <div class="eco-txt">
        <h2 class="eco-t" data-letras="eco">{ecoTitulo(lang)}</h2>
        <p class="sello" data-aparece>{tr(E.sello, lang)}</p>
        <p class="cod" data-aparece>{w('Cortometraje · thriller psicológico', 'Short film · psychological thriller')} · {E.duracion} · {E.formato}</p>
        <p class="golpe" data-lineas>“{tr(E.golpe, lang)}”</p>
        <a class="lnk eco-l" href={ruta(E.slug, lang)} data-aparece>{x.conocerEco}</a>
      </div>
      <Foto n="eco-madre" clase="eco-foto" movil={false} alt={w('Una mujer mayor sentada en un sofá, en penumbra', 'An older woman seated on a sofa in half light')} cursor={x.cursor.ver} sizes="(max-width: 860px) 100vw, 60vw" />
    </div>
    <div class="luz">{E.luz.map((n, k) => <figure><Image src={img(n)} alt="" widths={[260]} /></figure>)}</div>
  </section>

  <section class="blog papel grano" id="blog">
    <Enc t={x.blog} />
    {arts.map((a, k) => (
      <a class="fila" href={ruta('blog/' + a.slug, 'es')} data-cursor={x.cursor.leer} data-img={img(a.imagen).src} hreflang="es">
        <span data-lineas>{a.titulo}</span><em>{a.tema}{a.estado !== 'publicado' ? ' · borrador' : ''}</em>
      </a>
    ))}
  </section>
</Base>
