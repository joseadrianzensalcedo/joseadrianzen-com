---
import Articulo from '../../vistas/Articulo.astro';
import { visibles } from '../../data/blog.js';
import { PROTOTIPO } from '../../utils.js';
export function getStaticPaths() {
  const lista = visibles(process.env.PROTOTIPO === 'true');
  return lista.map((art, i) => ({ params: { slug: art.slug }, props: { art, numero: String(lista.length - i).padStart(2, '0') } }));
}
const { art, numero } = Astro.props;
---
<Articulo art={art} numero={numero} lang="es" />
