---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Documental from '../components/Documental.astro';
import Eco from '../components/Eco.astro';
import Fotografia from '../components/Fotografia.astro';
import Director from '../components/Director.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://joseadrianzen.com/#web',
      name: 'Jose Adrianzen',
      url: 'https://joseadrianzen.com/',
      inLanguage: 'es',
      publisher: { '@id': 'https://joseadrianzen.com/#jose' },
    },
    {
      '@type': 'Person',
      '@id': 'https://joseadrianzen.com/#jose',
      name: 'Jose Adrianzen',
      url: 'https://joseadrianzen.com/',
      image: 'https://joseadrianzen.com/assets/jose-retrato-b.webp',
      jobTitle: 'Director de cine',
      description: 'Director y productor de cine peruano. Autor del documental Entre polvo y sueños y del cortometraje ECO.',
      nationality: 'PE',
      sameAs: ['https://www.instagram.com/jadrianzens/', 'https://www.linkedin.com/in/joseadrianzens/'],
    },
    {
      '@type': 'Movie',
      '@id': 'https://joseadrianzen.com/#polvo',
      name: 'Entre polvo y sueños',
      dateCreated: '2025',
      countryOfOrigin: 'PE',
      inLanguage: 'es',
      director: { '@id': 'https://joseadrianzen.com/#jose' },
      genre: 'Documental',
      image: 'https://joseadrianzen.com/assets/afiche.webp',
      description: 'Documental sobre un grupo de mujeres mineras del Perú que buscan formalizarse y una vida mejor. Tres años de rodaje en socavones y pampas.',
      award: [
        'Mejor documental, TITAN International Film Festival, Sídney (2025)',
        'Mejor guion, 13.º Noida International Film Festival, India (2026)',
        'Best of Festival, Docuvision International Film Festival, EE. UU. (2026)',
        'Mención especial, 13.º Noida International Film Festival, India (2026)',
      ],
      subtitleLanguage: ['fr', 'en', 'tr'],
    },
    {
      '@type': 'Movie',
      '@id': 'https://joseadrianzen.com/#eco',
      name: 'ECO',
      dateCreated: '2023',
      countryOfOrigin: 'PE',
      inLanguage: 'es',
      director: { '@id': 'https://joseadrianzen.com/#jose' },
      genre: 'Thriller psicológico',
      description: 'Cortometraje de ficción aún sin estrenar. Guion de Matilde Carrión.',
      image: 'https://joseadrianzen.com/assets/eco-portada.webp',
    },
  ],
};
---
<Base
  title="Jose Adrianzen | Director de cine peruano"
  description="Jose Adrianzen, director de cine peruano. Su documental Entre polvo y sueños, sobre mujeres mineras del Perú, premiado en festivales, y el cortometraje ECO."
  ogDescription="Entre polvo y sueños, documental premiado sobre mujeres mineras del Perú, y el cortometraje ECO. Cine documental y ficción desde Perú."
  ogImageAlt="Tres mujeres mineras con casco en la pampa, fotograma de Entre polvo y sueños"
  canonical="https://joseadrianzen.com/"
  jsonLd={jsonLd}
>
  <div id="intro" aria-hidden="true">
    <div class="nm">Jose Adrianzen</div>
    <div class="ln">Director de cine</div>
  </div>

  <div class="grano" aria-hidden="true"></div>
  <div class="cur" id="cur" aria-hidden="true"></div>
  <div class="prog" id="prog" aria-hidden="true"></div>

  <Nav />

  <header class="hero" id="inicio">
    <p class="ojo">Director &middot; Productor</p>
    <h1><span class="fila"><i>Jose</i></span><span class="fila"><i>Adrianzen</i></span></h1>
    <p class="sub"><b>Cine documental y ficción</b><span class="dot"> &nbsp;&middot;&nbsp; </span><span class="pais">Perú</span></p>
    <a class="baja" href="#documental"><span>&darr;</span> Obras</a>
  </header>

  <hr class="regla">
  <Documental />
  <hr class="regla">
  <Eco />
  <hr class="regla">
  <Fotografia />
  <hr class="regla">
  <Director />

  <div class="visor" id="visor" role="dialog" aria-modal="true" aria-label="Foto ampliada">
    <button class="cerrar" type="button" id="cerrarVisor">Cerrar &times;</button>
    <img id="visorImg" src="" alt="">
  </div>

  <hr class="regla">
  <Contacto />
  <Footer />

  <script is:inline src="https://player.vimeo.com/api/player.js" defer></script>
  <script>
    import '../scripts/site.js';
  </script>
</Base>
