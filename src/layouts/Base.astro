---
// Plantilla común de todas las páginas: cabecera, menú, pie, cursor, estela de píxeles y motor de movimiento.
import Nav from '../components/Nav.astro';
import MenuCapa from '../components/MenuCapa.astro';
import Pie from '../components/Pie.astro';
import { t, tr } from '../data/textos.js';
import { ruta, PROTOTIPO } from '../utils.js';
import { premios, persona } from '../data/sitio.js';
import { IDIOMAS, idioma } from '../data/idiomas.js';
import '../styles/fuentes.css';
import '../styles/base.css';
import '../styles/paginas.css';
import '../styles/idiomas.css';
import '../styles/diseno.css';

const { titulo, descripcion, lang = 'es', camino = '', actual = '', navClara = false, intro = false, imagenOg = '/og.jpg', altOg = null, tipo = 'website', jsonLd = [], clase = '', soloEs = false, navCorto = false } = Astro.props;
// Los artículos del blog existen solo en español: en los otros idiomas el selector lleva a la lista del blog.
const caminoOtros = soloEs ? 'blog' : camino;
const w = (es, en) => tr({ es, en }, lang);
const x = t(lang);
const sitio = Astro.site?.href.replace(/\/$/, '') || 'https://joseadrianzen.com';
const url = sitio + ruta(camino, lang);
const urlEs = sitio + ruta(camino, 'es');
const info = idioma(lang);
const persona_ld = {
  '@context': 'https://schema.org', '@type': 'Person', '@id': sitio + '/#jose', name: persona.nombre,
  jobTitle: w('Director y productor de cine', 'Film director and producer'), url: sitio + '/',
  sameAs: ['https://www.instagram.com/jadrianzens/', 'https://www.linkedin.com/in/joseadrianzens/'],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'EPIC, IES Peruano de Cine y Creatividad' },
  homeLocation: { '@type': 'Place', name: 'Lima, Perú' },
  award: premios.map((p) => `${p.k.es}, ${p.v}`),
};
const textosMov = { menu: x.menu, cerrar: x.cerrar, pausa: x.pausa, seguir: x.seguir, detener: x.detener, mover: x.mover, saltarIntro: x.saltarIntro };
---
<!doctype html>
<html lang={lang} dir={info.dir} class={clase}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <script is:inline set:html={`(function(){var h=document.documentElement;if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;h.classList.add('mov');var v=0;try{v=sessionStorage.getItem('ja-intro')==='1'}catch(e){}${intro ? "if(!v)h.classList.add('intro');" : ''}setTimeout(function(){if(!window.__mov)h.classList.remove('mov','intro')},4000)})()`} />
  <title>{titulo}</title>
  <meta name="description" content={descripcion}>
  <link rel="canonical" href={url}>
  {IDIOMAS.filter((i) => !soloEs || i.c === 'es').map((i) => <link rel="alternate" hreflang={i.c} href={sitio + ruta(camino, i.c)} />)}
  <link rel="alternate" hreflang="x-default" href={urlEs}>
  {PROTOTIPO && <meta name="robots" content="noindex, nofollow">}
  <meta name="theme-color" content="#0c0b0a">
  <meta name="color-scheme" content="dark light">
  <link rel="icon" href={ruta('favicon.svg').replace(/\/$/, '')} type="image/svg+xml">
  <link rel="icon" href={ruta('icono-32.png').replace(/\/$/, '')} sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href={ruta('icono-180.png').replace(/\/$/, '')}>
  <link rel="preload" href={ruta('fuentes/bebas-neue/bebas-neue-latin-400-normal.woff2').replace(/\/$/, '')} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={ruta('fuentes/newsreader/newsreader-latin-wght-normal.woff2').replace(/\/$/, '')} as="font" type="font/woff2" crossorigin>
  <meta property="og:type" content={tipo}>
  <meta property="og:site_name" content="Jose Adrianzen">
  <meta property="og:locale" content={info.og}>
  <meta property="og:title" content={titulo}>
  <meta property="og:description" content={descripcion}>
  <meta property="og:url" content={url}>
  <meta property="og:image" content={sitio + imagenOg}>
  <meta property="og:image:alt" content={altOg ?? tr({ es: 'Jose Adrianzen, director de cine', en: 'Jose Adrianzen, film director' }, lang)}>
  <meta name="twitter:card" content="summary_large_image">
  <script type="application/ld+json" set:html={JSON.stringify([persona_ld, ...[].concat(jsonLd)])} />
  <script type="application/json" id="textos-mov" set:html={JSON.stringify(textosMov)} />
</head>
<body class:list={[{ 'nav-clara': navClara }]}>
  <a class="saltar-contenido" href="#contenido">{x.saltar}</a>
  <Nav lang={lang} actual={actual} camino={camino} caminoOtros={caminoOtros} corto={navCorto} />
  <MenuCapa lang={lang} actual={actual} camino={camino} caminoOtros={caminoOtros} />
  <main id="contenido">
    {PROTOTIPO && <p class="aviso-prototipo">{w('Prototipo · no publicado', 'Prototype · not published')}</p>}
    <slot />
    {!['es', 'en'].includes(lang) && <p class="aviso-traduccion" lang={lang}>{x.aviso}</p>}
  </main>
  <Pie lang={lang} />
  <img class="flota" alt="" aria-hidden="true">
  <div class="cursor" aria-hidden="true"><span class="aro"></span><span class="punto"></span><b></b></div>
  <div class="tc" aria-hidden="true"><i>TC</i><span>00:00:00:00</span></div>
  <div id="aviso-medidor" class="aviso-medidor" role="region" aria-label={w('Aviso de medición', 'Measurement notice')} hidden>
    <p>{w('Esta web cuenta sus visitas y lo que se ve en ella, sin Google ni otras empresas. ¿Te reconocemos cuando vuelvas?', 'This site counts its visits and what people watch on it, with no Google or other companies involved. Shall we recognize you when you come back?')} <a href={ruta('privacidad', lang)}>{w('Cómo se mide', 'How it works')}</a></p>
    <div><button type="button" data-ok="1">{w('Sí', 'Yes')}</button><button type="button" data-ok="0">{w('No', 'No')}</button></div>
  </div>
  <script>import '../scripts/movimiento.js';</script>
  <script>import '../scripts/medidor.js';</script>
</body>
</html>
