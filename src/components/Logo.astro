---
// Logo de Jose Adrianzen con cada letra separada (dibujo idéntico al original). La línea de código cambia según la página.
// En idiomas con otro alfabeto (ru, uk, zh, ja, ko, ar, hi, th) el nombre va escrito en ese alfabeto: archivo <variante>.<idioma>.svg,
// generado con logo_idiomas.py. Rayas, código y tamaño son los mismos del original.
const logos = import.meta.glob('/src/assets/logos/*.svg', { query: '?raw', import: 'default', eager: true });
const { variante = 'nav', armar = false, titulo = 'Jose Adrianzen', lang = 'es' } = Astro.props;
let svg = logos[`/src/assets/logos/${variante}.${lang}.svg`] ?? logos[`/src/assets/logos/${variante}.svg`];
if (!svg) throw new Error('Falta el logo ' + variante);
svg = svg.replace('<svg ', `<svg role="img" aria-label="${titulo}" ${armar ? 'data-armar ' : ''}`);
---
<Fragment set:html={svg} />
