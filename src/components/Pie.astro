---
import Logo from './Logo.astro';
import { t, tr } from '../data/textos.js';
import { ruta } from '../utils.js';
import { vias, correoUrl } from '../data/sitio.js';
const { lang = 'es' } = Astro.props;
const x = t(lang);
---
<footer class="pie oscuro grano" id="pie">
  <div class="pie-logo"><Logo variante="contacto" lang={lang} /></div>
  <div class="pie-mapa">
    {x.nav.map(([p, txt]) => <a href={ruta(p, lang)}>{txt}</a>)}
    {vias.map((v) => <a href={v.href} target={v.ext ? '_blank' : undefined} rel={v.ext ? 'noopener' : undefined}>{tr(v.t, lang)}</a>)}
    <a href={correoUrl}>{x.correoWeb}</a>
  </div>
  <div class="pie-base"><span>© 2026 Jose Adrianzen</span>{x.pieBase.map((s) => <span>{s}</span>)}</div>
</footer>
