---
// Foto con su tamaño justo para cada pantalla (480, 800 y 1200 px de ancho en WebP).
// pix: entra en píxeles y se pixela bajo el cursor o el dedo. paralaje: se mueve más lento que la página.
import { Image } from 'astro:assets';
const fotos = import.meta.glob('/src/assets/img/*.{webp,jpg,png}', { eager: true });
const { n, alt = '', clase = '', pix = true, paralaje = false, cursor, eager = false, sizes = '(max-width: 860px) 100vw, 50vw', pos, pie, filtro } = Astro.props;
const meta = (Object.entries(fotos).find(([k]) => k.split('/').pop().replace(/\.\w+$/, '') === n) || [])[1]?.default;
if (!meta) throw new Error('Falta la foto ' + n);
const anchos = [480, 800, 1200].filter((w) => w <= meta.width).concat(meta.width < 1200 ? [meta.width] : []);
---
<figure class:list={['foto', clase]} data-pix={pix ? '' : undefined} data-paralaje={paralaje ? '' : undefined} data-cursor={cursor} data-filtro={filtro}>
  <span class:list={['encuadre', { 'con-paralaje': paralaje }]}>
    <Image src={meta} alt={alt} widths={[...new Set(anchos)]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" style={pos ? `object-position:${pos}` : undefined} />
  </span>
  {pie && <figcaption>{pie}</figcaption>}
</figure>
