---
import { vias } from '../data/sitio.js';
---
<section id="contacto" class="contacto" aria-labelledby="t-con">
  <div class="rv rv--flash">
    <span class="marca">Proyectos, festivales y colaboraciones</span>
    <h2 class="titulo-seccion" id="t-con">Contacto</h2>
  </div>
  <div class="vias rv rv--up">
    {vias.map(v => (
      <a class="via" href={v.href} {...(v.ext ? { target: '_blank', rel: 'noopener' } : {})}>
        <small>{v.t}</small>{v.v}
      </a>
    ))}
  </div>
  <p class="lugar">Lima &middot; Perú</p>
</section>
