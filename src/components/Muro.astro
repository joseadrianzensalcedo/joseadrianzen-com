---
import { img } from '../utils.js';
const { items, id, estilo } = Astro.props;
---
<div class="muro rv rv--cascada" id={id} style={estilo}>
  {items.map(([nombre, alt], i) => (
    <button type="button" style={`--i:${i}`}><img src={img(nombre)} alt={alt} loading="lazy" decoding="async"></button>
  ))}
</div>
