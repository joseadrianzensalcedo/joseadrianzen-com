---
import { img } from '../utils.js';
// Cada foto se revela por su cuenta: el muro es mas alto que la pantalla,
// asi que animarlo como un bloque unico dejaba fotos que ya habian
// terminado su entrada antes de que llegaras a verlas, y un contenedor
// que nunca alcanzaba a salir de cuadro.
const { items, id, estilo } = Astro.props;
---
<div class="muro" id={id} style={estilo}>
  {items.map(([nombre, alt]) => (
    <button type="button" class="rv rv--pieza">
      <img src={img(nombre)} alt={alt} loading="lazy" decoding="async">
    </button>
  ))}
</div>
