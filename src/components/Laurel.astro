---
// Laurel de festival dibujado con el código, con el texto del premio en la letra de la web.
const { arriba, medio, abajo, chico = false } = Astro.props;
const hojas = Array.from({ length: 7 }, (_, i) => i);
const rama = hojas.map((i) => { const t = i / 6, y = 90 - t * 80, x = 22 - Math.sin(t * Math.PI) * 9 - t * 2; return { x: x - 6, y, r: -40 + t * 20 }; });
---
<li class:list={['laurel', { chico }]}>
  <svg class="rama" viewBox="0 0 30 100" aria-hidden="true"><path d="M24 96 Q6 60 20 6" fill="none" stroke="currentColor" stroke-width="1.4"/>{rama.map((h) => <ellipse cx={h.x} cy={h.y} rx="6.5" ry="2.6" transform={`rotate(${h.r} ${h.x} ${h.y})`} fill="currentColor" />)}</svg>
  <span class="laurel-txt">{arriba && <b>{arriba}</b>}<span>{medio}</span>{abajo && <i>{abajo}</i>}</span>
  <svg class="rama der" viewBox="0 0 30 100" aria-hidden="true"><path d="M24 96 Q6 60 20 6" fill="none" stroke="currentColor" stroke-width="1.4"/>{rama.map((h) => <ellipse cx={h.x} cy={h.y} rx="6.5" ry="2.6" transform={`rotate(${h.r} ${h.x} ${h.y})`} fill="currentColor" />)}</svg>
</li>
