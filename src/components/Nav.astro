---
import Logo from './Logo.astro';
import { t, tr } from '../data/textos.js';
import { ruta } from '../utils.js';
import Idiomas from './Idiomas.astro';
const { lang = 'es', actual = '', camino = '', caminoOtros = camino, corto = false } = Astro.props;
// En la portada el nombre ya va grande abajo, así que arriba va el logo corto JA (pedido de la diseñadora, 1 oct 2026).
// En los idiomas con otro alfabeto el nombre va escrito en ese alfabeto y no hay iniciales latinas que sirvan: ahí queda el logo completo.
const LATINO = !['ru', 'uk', 'zh', 'ja', 'ko', 'ar', 'hi', 'th'].includes(lang);
const w = (es, en) => tr({ es, en }, lang);
const x = t(lang);
---
<header class="nav">
  <a class="nav-logo" href={ruta('', lang)} aria-label={w('Jose Adrianzen, inicio', 'Jose Adrianzen, home')}><Logo variante={corto && LATINO ? 'ja' : 'nav'} lang={lang} /></a>
  <nav aria-label={w('Principal', 'Main')}>
    {x.nav.map(([p, txt]) => <a href={ruta(p, lang)} aria-current={actual === p ? 'page' : undefined}>{txt}</a>)}
    <Idiomas lang={lang} camino={camino} caminoOtros={caminoOtros} />
  </nav>
  <button class="menu" type="button">{x.menu}</button>
</header>
