---
import Muro from './Muro.astro';
import { fotografia } from '../data/sitio.js';
---
<section id="fotografia" aria-labelledby="t-foto">
  <div class="cabecera rv rv--flash">
    <span class="marca">Bitácora visual</span>
    <h2 class="titulo-seccion" id="t-foto">Fotografía</h2>
    <p class="nota"><a href="https://www.instagram.com/jadrianzens/" target="_blank" rel="noopener">@jadrianzens</a></p>
  </div>
  <Muro items={fotografia} id="muro-foto" />
</section>
